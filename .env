# ── StudyBot Environment Configuration ────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit your real .env to version control.

# ── AI Provider ───────────────────────────────────────────────────────
# Which provider handles chat/quiz/summary/explain requests.
# Options: "huggingface" | "anthropic" | "openai"
AI_PROVIDER=openrouter

OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxx

# ── HuggingFace (Inference API — cloud, Mistral-7B) ───────────────────
# Get a free token at https://huggingface.co/settings/tokens
# Required only when HF_MODE=api (the default)
HF_API_KEY=hf_xxxxxxxxxxxxxxxx

# "api"   → HuggingFace Inference API, Mistral-7B (fast, cloud, needs HF_API_KEY)
# "local" → local transformers pipeline  (slow first run, no API key needed)
HF_MODE=api

# Cloud model used when HF_MODE=api
HF_API_MODEL=google/flan-t5-base

# Local model used when HF_MODE=local (downloaded on first run)
HF_MODEL=google/flan-t5-base

# ── Anthropic (optional) ──────────────────────────────────────────────
# Set AI_PROVIDER=anthropic to use Claude.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── OpenAI (optional) ─────────────────────────────────────────────────
# Set AI_PROVIDER=openai to use GPT-4o.
OPENAI_API_KEY=sk-your-key-here

# ── App ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production

